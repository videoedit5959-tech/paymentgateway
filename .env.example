# PaySync Non-API MFS Payment Gateway Environment Variables
MONGODB_URI="mongodb://localhost:27017/paysync"
JWT_ACCESS_SECRET="paysync_jwt_access_secret_super_secure_key_min_32_chars"
JWT_REFRESH_SECRET="paysync_jwt_refresh_secret_super_secure_key_min_32_chars"
ENCRYPTION_KEY="paysync_aes256_encryption_key_32bytes"
WEBHOOK_SIGNING_SECRET="paysync_webhook_hmac_secret_key"
DEVICE_AUTH_SECRET="paysync_device_pairing_and_auth_secret"
APP_URL="http://localhost:3000"
API_URL="http://localhost:3000/api"
PORT=3000
