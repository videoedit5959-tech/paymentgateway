# ==============================================================================
# PaySync MFS Payment Gateway — Complete Environment Variables Specification
# Copy this template to `.env` for local development.
# DO NOT put real secrets or production credentials into this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Execution mode: 'development' | 'staging' | 'production' | 'test'
NODE_ENV=development

# Internal HTTP listening port for Express application server
PORT=3000

# Logging verbosity: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=debug


# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MONGODB)
# ------------------------------------------------------------------------------
# Connection string for MongoDB database instance or MongoDB Atlas cluster.
MONGODB_URI=mongodb://127.0.0.1:27017/paysync_dev

# Enforce strict production database connection (disables memory DB fallback)
ALLOW_IN_MEMORY_FALLBACK=true

# Force production database strict mode (used in connect.ts and envValidator.ts)
STRICT_PRODUCTION_MODE=false

# Populate demo seed data on startup if database is empty ('true' | 'false')
SEED_DEMO_DATA=true


# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECRETS
# ------------------------------------------------------------------------------
# Cryptographic secret for signing JWT user access tokens (>= 24 chars, secret)
JWT_ACCESS_SECRET=dev_jwt_access_secret_min_32_characters_long

# Cryptographic secret for signing user refresh tokens (>= 24 chars, secret)
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_min_32_characters_long


# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHIC, DEVICE AUTH & WEBHOOK SECRETS
# ------------------------------------------------------------------------------
# 32-byte (256-bit) secret key for AES-256 data encryption at rest (secret)
ENCRYPTION_KEY=dev_aes256_encryption_key_must_be_32_bytes_long

# Default HMAC-SHA256 signing secret for outgoing merchant webhooks (secret)
WEBHOOK_SIGNING_SECRET=dev_webhook_hmac_signing_secret_min_32_chars

# Master key for Android Collector QR pairing & device authentication (secret)
DEVICE_AUTH_SECRET=dev_android_device_pairing_and_auth_secret_32chars

# Authorization secret for Vercel Cron background worker triggers (secret)
CRON_SECRET=dev_cron_execution_secret_key_32chars


# ------------------------------------------------------------------------------
# 5. PUBLIC BASE URLS
# ------------------------------------------------------------------------------
# Canonical base URL for the web application & merchant portal
APP_URL=http://localhost:3000

# Base URL for REST API endpoints
API_URL=http://localhost:3000/api

# Base URL for hosted customer payment checkout sessions
CHECKOUT_URL=http://localhost:3000/checkout


# ------------------------------------------------------------------------------
# 6. SECURITY, CORS & SYSTEM CONTROLS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for cross-origin browser requests
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Global system kill-switch: 'true' blocks non-admin API writes with 503
MAINTENANCE_MODE=false

# Disable Hot Module Replacement in Vite container environment ('true' | 'false')
DISABLE_HMR=true


# ------------------------------------------------------------------------------
# 7. PAYMENT ENGINE & OPERATIONAL OVERRIDES
# ------------------------------------------------------------------------------
# Default hosted checkout session TTL expiry window in minutes
PAYMENT_EXPIRY_MINUTES=15


# ------------------------------------------------------------------------------
# 8. FINE-GRAINED RATE LIMITING OVERRIDES (OPTIONAL - HAS PRODUCTION DEFAULTS)
# ------------------------------------------------------------------------------
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

RATE_LIMIT_REGISTER_WINDOW_MS=1800000
RATE_LIMIT_REGISTER_MAX=10

RATE_LIMIT_PAYMENT_WINDOW_MS=60000
RATE_LIMIT_PAYMENT_MAX=60

RATE_LIMIT_VERIFY_WINDOW_MS=300000
RATE_LIMIT_VERIFY_MAX=25

RATE_LIMIT_SMS_WINDOW_MS=60000
RATE_LIMIT_SMS_MAX=150

RATE_LIMIT_PAIRING_WINDOW_MS=600000
RATE_LIMIT_PAIRING_MAX=15

RATE_LIMIT_APIKEY_WINDOW_MS=60000
RATE_LIMIT_APIKEY_MAX=30


# ------------------------------------------------------------------------------
# 9. SDK & CLIENT INTEGRATION TEST VARIABLES (DOCS / EXAMPLES ONLY)
# ------------------------------------------------------------------------------
# These variables are used in client SDK examples and integration tests.
PAYSYNC_API_KEY=ps_test_sample_key_12345
PAYSYNC_API_SECRET=ps_test_sample_secret_67890
PAYSYNC_WEBHOOK_SECRET=ps_test_webhook_secret_abcde
PAYSYNC_BASE_URL=http://localhost:3000
